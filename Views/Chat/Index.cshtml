@using System.Linq
@model GPTCvAssistant.Models.ChatModel

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Mazhar Hayat – AI-Powered Career Profile</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" rel="stylesheet">
    <link href="~/content/css/chat.css" rel="stylesheet" />
    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    <script src="https://js.puter.com/v2/"></script>
    
    <!-- Define global functions that need to be available before DOM is loaded -->
    <script>
        // Global functions for button click handlers
        // Define submitPrompt in global scope before it's called by buttons
        function submitPrompt(prompt, intent = 'Default') {
            if (!prompt && intent === 'Default') {
                console.error('submitPrompt called without prompt or intent');
                return;
            }
            
            console.log(`submitPrompt called with prompt: ${prompt}, intent: ${intent}`);
            
            // If chatApp isn't ready yet, wait and retry
            if (typeof chatApp === 'undefined') {
                console.log('chatApp not ready, waiting...');
                setTimeout(() => submitPrompt(prompt, intent), 100);
                return;
            }
            
            // Set the value in the input field for visibility
            $('#userQuestion').val(prompt).focus();
            
            // Call the sendMessage method with the specified intent
            chatApp.sendMessage(intent);
        }

        function prefill(text) {
            const box = document.getElementById('userQuestion');
            if (!box) return;
            box.value = text;
            box.focus();
        }

        function toggleSearch() {
            const wrap = document.getElementById('searchWrapper');
            if (wrap) {
                wrap.style.display = wrap.style.display === 'none' ? 'block' : 'none';
                if (wrap.style.display === 'block') {
                    document.getElementById('searchBox').focus();
                }
            }
        }

        // Job Match Agent Functions
        function showJobAnalysisModal() {
            const modal = new bootstrap.Modal(document.getElementById('jobAnalysisModal'));
            modal.show();
        }

        async function analyzeJob() {
            const jobDescription = document.getElementById('jobDescriptionInput').value.trim();
            const companyName = document.getElementById('companyNameInput').value.trim();
            const targetRole = document.getElementById('targetRoleInput').value.trim();

            if (!jobDescription) {
                alert('Please enter a job description.');
                return;
            }

            try {
                chatApp.setLoading(true);
                
                const response = await fetch('/Chat/AnalyzeJob', {
                    method: 'POST',
                    headers: { 
                        'Content-Type': 'application/json',
                        'Accept': 'application/json'
                    },
                    body: JSON.stringify({
                        jobDescription: jobDescription,
                        companyName: companyName,
                        targetRole: targetRole
                    })
                });

                if (!response.ok) {
                    throw new Error(`Server error: ${response.status}`);
                }

                const result = await response.json();
                
                if (result.success) {
                    // Log the HTML for debugging
                    console.log('Raw HTML received:', result.html);
                    
                    // Add to chat history with special styling
                    const exchange = {
                        userQuestion: `Job Analysis: ${targetRole || 'Position'} ${companyName ? `at ${companyName}` : ''}`,
                        answer: result.html
                    };
                    
                    chatApp.addChatEntry(exchange, 'JobAnalysis');
                    chatApp.scrollToBottom();
                    
                    // Close modal
                    bootstrap.Modal.getInstance(document.getElementById('jobAnalysisModal')).hide();
                    
                    // Clear form
                    document.getElementById('jobDescriptionInput').value = '';
                    document.getElementById('companyNameInput').value = '';
                    document.getElementById('targetRoleInput').value = '';
                    
                    chatApp.showToast('Job analysis completed!');
                } else {
                    alert(result.message || 'Failed to analyze job');
                }
            } catch (error) {
                console.error('Error analyzing job:', error);
                alert('Network error occurred. Please try again.');
            } finally {
                chatApp.setLoading(false);
            }
        }

