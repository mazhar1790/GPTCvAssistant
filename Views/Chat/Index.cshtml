        async function startVideoInterview() {
            try {
                const stream = await navigator.mediaDevices.getUserMedia({ video: true, audio: true });
                document.getElementById('videoElement').srcObject = stream;
                
                // Show video interview modal
                const modal = new bootstrap.Modal(document.getElementById('videoInterviewModal'));
                modal.show();
                
                // Start interview simulation
                const role = 'AI Solutions Architect'; // Default role
                const response = await fetch('/AdvancedCareer/StartInterviewSimulation', {
                    method: 'POST',
                    headers: { 
                        'Content-Type': 'application/json',
                        'Accept': 'application/json'
                    },
                    body: JSON.stringify({
                        role: role,
                        company: 'Technology Company',
                        interviewType: 'Technical',
                        difficulty: 'Intermediate'
                    })
                });

                const result = await response.json();
                if (result.success) {
                    document.getElementById('interviewQuestion').innerHTML = result.html;
                }
            } catch (error) {
                console.error('Error starting video interview:', error);
                alert('Camera access denied or not available. Please check your browser settings.');
            }
        }

        async function showPersonalBrandBuilder() {
            const modal = new bootstrap.Modal(document.getElementById('personalBrandModal'));
            modal.show();
        }

        async function generatePersonalBrand() {
            const currentRole = document.getElementById('brandCurrentRole').value.trim();
            const targetRole = document.getElementById('brandTargetRole').value.trim();
            const industry = document.getElementById('brandIndustry').value.trim();

            if (!currentRole || !targetRole) {
                alert('Please enter both current and target roles.');
                return;
            }

            try {
                chatApp.setLoading(true);
                
                const response = await fetch('/AdvancedCareer/CreatePersonalBrand', {
                    method: 'POST',
                    headers: { 
                        'Content-Type': 'application/json',
                        'Accept': 'application/json'
                    },
                    body: JSON.stringify({
                        currentRole: currentRole,
                        targetRole: targetRole,
                        industry: industry || 'Technology',
                        keySkills: ['AI', 'Machine Learning', '.NET', 'Azure', 'Leadership'],
                        achievements: ['Led AI implementation projects', 'Delivered enterprise solutions'],
                        personalityType: 'Technical Leader'
                    })
                });

                const result = await response.json();
                
                if (result.success) {
                    const exchange = {
                        userQuestion: `🎨 Personal Brand Strategy: ${currentRole} → ${targetRole}`,
                        answer: formatPersonalBrandResponse(result.brand)
                    };
                    
                    chatApp.addChatEntry(exchange, 'PersonalBrandBuilder');
                    chatApp.scrollToBottom();
                    
                    // Close modal
                    bootstrap.Modal.getInstance(document.getElementById('personalBrandModal')).hide();
                    
                    chatApp.showToast('Personal brand strategy created!');
                } else {
                    alert(result.message || 'Failed to create personal brand');
                }
            } catch (error) {
                console.error('Error creating personal brand:', error);
                alert('Network error occurred. Please try again.');
            } finally {
                chatApp.setLoading(false);
            }
        }

        function formatPersonalBrandResponse(brand) {
            return `
                <div class="personal-brand-strategy">
                    <h3>Your Personal Brand Strategy</h3>
                    <div class="brand-section">
                        <h4>Brand Message</h4>
                        <p>${brand.brandMessage}</p>
                    </div>
                    <div class="brand-section">
                        <h4>Value Proposition</h4>
                        <p>${brand.valueProposition}</p>
                    </div>
                    <div class="brand-section">
                        <h4>LinkedIn Optimization</h4>
                        <p><strong>Headline:</strong> ${brand.linkedInStrategy.headline}</p>
                        <p><strong>Summary:</strong> ${brand.linkedInStrategy.summary}</p>
                    </div>
                </div>
            `;
        }

