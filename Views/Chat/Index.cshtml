        async function showCareerPathAnalysis() {
            const modal = new bootstrap.Modal(document.getElementById('careerPathModal'));
            modal.show();
        }

        async function generateCareerPaths() {
            const currentRole = document.getElementById('pathCurrentRole').value.trim();
            const interests = document.getElementById('pathInterests').value.trim();
            const yearsExperience = parseInt(document.getElementById('pathExperience').value) || 0;

            if (!currentRole) {
                alert('Please enter your current role.');
                return;
            }

            try {
                chatApp.setLoading(true);
                
                const response = await fetch('/AdvancedCareer/GetCareerPaths', {
                    method: 'POST',
                    headers: { 
                        'Content-Type': 'application/json',
                        'Accept': 'application/json'
                    },
                    body: JSON.stringify({
                        currentRole: currentRole,
                        skills: ['AI', 'Machine Learning', '.NET', 'Azure', 'Leadership'],
                        interests: interests,
                        yearsExperience: yearsExperience,
                        preferredIndustry: 'Technology',
                        careerGoals: 'Advance to senior leadership roles in AI'
                    })
                });

                const result = await response.json();
                
                if (result.success) {
                    const exchange = {
                        userQuestion: `🛣️ Career Path Analysis from ${currentRole}`,
                        answer: formatCareerPathResponse(result.recommendations)
                    };
                    
                    chatApp.addChatEntry(exchange, 'CareerPathRecommendation');
                    chatApp.scrollToBottom();
                    
                    // Close modal
                    bootstrap.Modal.getInstance(document.getElementById('careerPathModal')).hide();
                    
                    chatApp.showToast('Career path analysis completed!');
                } else {
                    alert(result.message || 'Failed to analyze career paths');
                }
            } catch (error) {
                console.error('Error analyzing career paths:', error);
                alert('Network error occurred. Please try again.');
            } finally {
                chatApp.setLoading(false);
            }
        }

        function formatCareerPathResponse(recommendations) {
            return `
                <div class="career-paths">
                    <h3>Your Career Path Recommendations</h3>
                    <div class="career-advice">
                        <h4>Career Advice</h4>
                        <p>${recommendations.careerAdvice}</p>
                    </div>
                    <div class="recommended-paths">
                        <h4>Recommended Career Paths</h4>
                        ${recommendations.recommendedPaths.map(path => `
                            <div class="career-path">
                                <h5>${path.title}</h5>
                                <p>${path.description}</p>
                                <p><strong>Timeline:</strong> ${path.timeline}</p>
                                <p><strong>Market Demand:</strong> ${path.marketDemand}/10</p>
                            </div>
                        `).join('')}
                    </div>
                </div>
            `;
        }

        async function submitInterviewAnswer() {
            const answer = document.getElementById('interviewAnswer').value.trim();
            if (!answer) {
                alert('Please enter your answer.');
                return;
            }

            try {
                chatApp.setLoading(true);
                
                const response = await fetch('/AdvancedCareer/ContinueInterview', {
                    method: 'POST',
                    headers: { 
                        'Content-Type': 'application/json',
                        'Accept': 'application/json'
                    },
                    body: JSON.stringify({
                        previousAnswer: answer,
                        role: 'AI Solutions Architect'
                    })
                });

                const result = await response.json();
                
                if (result.success) {
                    document.getElementById('interviewQuestion').innerHTML = result.html;
                    document.getElementById('interviewAnswer').value = '';
                } else {
                    alert(result.message || 'Failed to continue interview');
                }
            } catch (error) {
                console.error('Error continuing interview:', error);
                alert('Network error occurred. Please try again.');
            } finally {
                chatApp.setLoading(false);
            }
        }
    </script>
</head>
<body>
    <button id="themeToggle" class="btn">🌙</button>

    <div class="chat-container">
        <div class="chat-header">
            <h1>
                <i class="fas fa-briefcase"></i>
                <span id="profileName" class="hover-profile">Mazhar Hayat</span>
                – AI-Powered Career Profile
            </h1>
            <p class="text-muted">Ask anything about Mazhar Hayat's experience, skills, and projects — delivered through an interactive AI assistant built for career insights.</p>
        </div>

        <!-- Alert container for messages -->
        <div id="alertContainer"></div>

        <div class="action-bar">
            <!-- Agentic actions (tailored to your profile) -->
            <button class="btn btn-outline-primary btn-arrow"
                    onclick="prefill('Interview me for an AI Solutions Architect role focusing on .NET, LLM, RAG, and Azure')">
                Interview Me
            </button>

            <button class="btn btn-outline-primary btn-arrow"
                    onclick="prefill('Write a cover letter for an AI Solutions Architect position in Abu Dhabi highlighting my .NET, LLM, RAG, and Azure experience')">
                Generate Cover Letter
            </button>

            <!-- New Job Match Agent Button -->
            <button class="btn btn-outline-success btn-arrow" onclick="showJobAnalysisModal()">
                🎯 Job Match Agent
            </button>

            <!-- New Advanced Career Tools Button -->
            <button class="btn btn-outline-warning btn-arrow" onclick="showAdvancedFeaturesModal()">
                🚀 Advanced Tools
            </button>

            <!-- Utilities |
            <button class="btn btn-outline-primary" onclick="toggleSearch()">Search History</button>
            <button class="btn btn-outline-danger" onclick="chatApp.clearHistory()">Clear History</button>
            <button class="btn btn-outline-primary" onclick="chatApp.downloadTranscript()">Download</button>
            <button class="btn btn-outline-primary" onclick="prefill('reset interview')">Reset Interview</button>
        </div>

        <!-- Job Analysis Modal -->
        <div class="modal fade" id="jobAnalysisModal" tabindex="-1" aria-labelledby="jobAnalysisModalLabel" aria-hidden="true">
            <div class="modal-dialog modal-lg">
                <div class="modal-content">
                    <div class="modal-header">
                        <h5 class="modal-title" id="jobAnalysisModalLabel">🎯 Job Match Agent</h5>
                        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                    </div>
                    <div class="modal-body">
                        <p class="text-muted mb-3">Paste a job description below and let AI analyze the fit, highlight strengths, identify gaps, and generate tailored application materials.</p>
                        
                        <div class="row mb-3">
                            <div class="col-md-6">
                                <label for="companyNameInput" class="form-label">Company Name (Optional)</label>
                                <input type="text" class="form-control" id="companyNameInput" placeholder="e.g., Microsoft">
                            </div>
                            <div class="col-md-6">
                                <label for="targetRoleInput" class="form-label">Target Role (Optional)</label>
                                <input type="text" class="form-control" id="targetRoleInput" placeholder="e.g., AI Solutions Architect">
                            </div>
                        </div>
                        
                        <div class="mb-3">
                            <label for="jobDescriptionInput" class="form-label">Job Description *</label>
                            <textarea class="form-control" id="jobDescriptionInput" rows="8" 
                                placeholder="Paste the full job description here..."></textarea>
                        </div>
                        
                        <div class="d-flex gap-2 flex-wrap">
                            <button type="button" class="btn btn-primary" onclick="analyzeJob()">
                                <i class="fas fa-chart-line me-2"></i>Analyze Job Fit
                            </button>
                            <button type="button" class="btn btn-success" onclick="generateCoverLetter()">
                                <i class="fas fa-file-alt me-2"></i>Generate Cover Letter
                            </button>
                            <button type="button" class="btn btn-info" onclick="optimizeForATS()">
                                <i class="fas fa-search me-2"></i>ATS Optimization
                            </button>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Advanced Features Modal -->
        <div class="modal fade" id="advancedFeaturesModal" tabindex="-1" aria-labelledby="advancedFeaturesModalLabel" aria-hidden="true">
            <div class="modal-dialog modal-xl">
                <div class="modal-content">
                    <div class="modal-header">
                        <h5 class="modal-title" id="advancedFeaturesModalLabel">🚀 Advanced Career Tools</h5>
                        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                    </div>
                    <div class="modal-body">
                        <div class="row g-3">
                            <div class="col-md-4">
                                <div class="card h-100 text-center">
                                    <div class="card-body">
                                        <i class="fas fa-chart-line fa-3x mb-3 text-primary"></i>
                                        <h6 class="card-title">Skills Gap Analysis</h6>
                                        <p class="card-text small">Analyze your skills against target roles and get personalized learning recommendations.</p>
                                        <button class="btn btn-primary btn-sm" onclick="conductSkillsAssessment()">
                                            Start Assessment
                                        </button>
                                    </div>
                                </div>
                            </div>
                            <div class="col-md-4">
                                <div class="card h-100 text-center">
                                    <div class="card-body">
                                        <i class="fas fa-chart-bar fa-3x mb-3 text-success"></i>
